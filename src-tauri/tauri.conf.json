{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pointcast",
  "version": "0.4.0",
  "identifier": "dev.pointcast.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "onboarding",
        "title": "Welcome to Pointcast",
        "url": "onboarding.html",
        "width": 720,
        "height": 660,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "visible": false,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 22
        },
        "windowEffects": {
          "effects": [
            "underWindowBackground",
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      },
      {
        "label": "settings",
        "title": "Pointcast Settings",
        "url": "index.html",
        "width": 860,
        "height": 620,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 22
        },
        "windowEffects": {
          "effects": [
            "sidebar",
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      },
      {
        "label": "indicator",
        "title": "Pointcast recording",
        "url": "indicator.html",
        "width": 392,
        "height": 64,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "overlay",
        "title": "Pointcast annotate",
        "url": "overlay.html",
        "width": 1280,
        "height": 800,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "result",
        "title": "Pointcast History",
        "url": "result.html",
        "width": 920,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false,
        "center": true,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 22
        },
        "windowEffects": {
          "effects": [
            "underWindowBackground",
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "category": "Productivity",
    "shortDescription": "Talk, point and paste one prompt into any AI tool",
    "longDescription": "Pointcast lives in the menu bar or tray. Press one shortcut, talk, and mark up the screen; when you stop, one prompt with your words and the annotated screenshots is ready to paste into any AI tool. Speech is transcribed on this computer.",
    "publisher": "Pointcast",
    "copyright": "MIT License"
  }
}