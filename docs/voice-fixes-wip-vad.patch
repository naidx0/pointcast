+    #[test]
+    fn a_second_fetch_while_one_runs_starts_nothing_and_one_after_it_ends_starts_again() {
+        use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+        use std::sync::Arc;
+        let (flag, runs) = (Arc::new(AtomicBool::new(false)), Arc::new(AtomicUsize::new(0)));
+        let (go, wait) = std::sync::mpsc::channel::<()>();
+        let r = runs.clone();
+        assert!(fetch_once(flag.clone(), move || {
+            let _ = wait.recv();
+            r.fetch_add(1, Ordering::SeqCst);
+        }));
+        let r = runs.clone();
+        assert!(!fetch_once(flag.clone(), move || {
+            r.fetch_add(100, Ordering::SeqCst);
+        }), "one is running");
+        go.send(()).unwrap();
+        let t = std::time::Instant::now();
+        while flag.load(Ordering::SeqCst) && t.elapsed() < std::time::Duration::from_secs(3) {
+            std::thread::sleep(std::time::Duration::from_millis(1));
+        }
+        assert_eq!(runs.load(Ordering::SeqCst), 1);
+        let (done, ended) = std::sync::mpsc::channel();
+        assert!(fetch_once(flag.clone(), move || done.send(()).unwrap()), "the last one ended");
+        ended.recv_timeout(std::time::Duration::from_secs(3)).unwrap();
+    }
