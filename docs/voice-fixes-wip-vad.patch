+/// Silero's settings for the model at `model` on the provider `provider`.
+fn silero_config(model: P, provider: P) -> VadConfig {
+    // Every field is a number or a pointer: all zeros is a valid start.
+    let mut cfg: VadConfig = unsafe { std::mem::zeroed() };
+    cfg.silero_vad.model = model;
+    cfg.silero_vad.threshold = THRESHOLD;
+    // One window of each: the answer per window, not sherpa's segments.
+    cfg.silero_vad.min_silence_duration = WINDOW as f32 / audio::RATE as f32;
+    cfg.silero_vad.min_speech_duration = WINDOW as f32 / audio::RATE as f32;
+    cfg.silero_vad.window_size = WINDOW as i32;
+    // A stretch of speech is kept until it ends: noise heard as speech all call long would grow it without end. Past
+    // this, sherpa cuts it into a segment (let go of at once) and goes on.
+    cfg.silero_vad.max_speech_duration = 30.0;
+    cfg.sample_rate = audio::RATE as i32;
+    cfg.num_threads = 1;
+    cfg.provider = provider;
+    cfg
+}
