# Every pinned input of the whisper helper build. The workflow and helper/build.sh read this file: bump versions here
# and nowhere else (helper/README.md says how). Plain KEY=VALUE lines, no quotes and no spaces, so bash can source it
# and GitHub Actions can load it into the job environment.

# whisper.cpp source release (GitHub's tag tarball; size and SHA-256 checked before anything is built).
WHISPER_TAG=v1.9.5
WHISPER_SRC_URL=https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v1.9.5.tar.gz
WHISPER_SRC_SHA256=ff1a9053feb509ff9d7729703355541ae9690073a6b1c40eb692c962e0dc1720
# Commit time of the tag (2026-10-06T14:10:35Z): every file in the archives carries it, so a rebuild packs the same way.
ARCHIVE_MTIME=1791295835

# LunarG Vulkan SDK: headers, glslc and the loader's import library, needed only to build (never shipped).
VULKAN_SDK_VERSION=1.4.357.0
VULKAN_SDK_WINDOWS_SHA256=81f474711e9042f4cd22b31b2f7a8870db2e428b21586fb43dd80150be97310d
VULKAN_SDK_LINUX_SHA256=0f09bf6a0625e346bf004be70b92907e934a4c76606b323441b2baf3a5a0e66d

# Model the smoke test transcribes with (whisper.cpp's own tiny.en, at a fixed Hugging Face revision).
TEST_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/5359861c739e955e79d9a303bcbc70fb988958b1/ggml-tiny.en.bin
TEST_MODEL_SHA256=921e4cf8686fdd993dcd081a5da5b6c365bfde1162e72b08d75ac75289920b1f
